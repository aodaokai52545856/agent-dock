{
  "name": "agent-dock",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "pack:exe": "tauri build --bundles nsis && node scripts/collect-win-exe.mjs",
    "icon:gen": "python scripts/generate_icon.py",
    "test:fit": "node --experimental-strip-types src/lib/termFit.test.ts",
    "test:bridge": "node --experimental-strip-types src/lib/reviewVerdict.test.ts",
    "test:usage": "node --experimental-strip-types src/lib/grokUsage.test.ts",
    "test:cite": "node --experimental-strip-types src/lib/sessionCite.test.ts && node --experimental-strip-types src/lib/markdown.test.ts",
    "spike:app-server": "node scripts/spike_app_server.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.31",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "marked": "^15.0.12",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "typescript": "~5.6.3",
    "vite": "^8.0.16",
    "vue-tsc": "^2.2.0"
  }
}
