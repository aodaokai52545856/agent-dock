{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Dock",
  "version": "0.1.3",
  "identifier": "com.aitools.agentdock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Dock",
        "width": 1280,
        "height": 840,
        "minWidth": 1100,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false,
        "theme": "Dark",
        "backgroundColor": "#0b0f13"
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "resources": [
      "../scripts/cursor_agent.mjs"
    ]
  }
}
